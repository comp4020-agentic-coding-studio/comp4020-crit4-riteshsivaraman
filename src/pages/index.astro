---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="CULTURE — a plate that plays"
  description="Tap the plate to seed a cell; it sounds, breeds and keeps playing. A generative instrument printed in three overprinted inks."
>
  <header>
    <h1>CULTURE</h1>
    <p class="tagline">a plate that plays</p>
    <nav aria-label="Primary">
      <a href="#about" id="about-link">About</a>
    </nav>
  </header>

  <canvas id="stage"></canvas>

  <p class="invite" data-invite>tap anywhere<br />higher is higher</p>

  <div class="specimen" id="specimen">
    <div class="row">
      <label class="row-label" for="mood-input">Mood</label>
      <select id="mood-input" data-control="mood">
        <option value="bright" selected>bright</option>
        <option value="deep">deep</option>
        <option value="open">open</option>
        <option value="warm">warm</option>
        <option value="night">night</option>
        <option value="glass">glass</option>
        <option value="sour">sour</option>
      </select>
    </div>
    <div class="row">
      <label class="row-label" for="drift-input">Drift</label>
      <input type="range" id="drift-input" data-control="drift" min="0" max="1" step="0.01" value="0.35" />
    </div>
    <div class="row">
      <label class="row-label" for="level-input">Level</label>
      <input type="range" id="level-input" data-control="level" min="0" max="1" step="0.01" value="1" />
    </div>
    <button type="button" class="clear-btn" data-control="clear">clear</button>
    <details class="conditions">
      <summary>conditions</summary>
      <div class="row">
        <label class="row-label" for="fertility-input">Fertility</label>
        <input
          type="range"
          id="fertility-input"
          data-control="fertility"
          min="0"
          max="1"
          step="0.01"
          value="0.11"
        />
      </div>
      <div class="row">
        <label class="row-label" for="vigour-input">Vigour</label>
        <input
          type="range"
          id="vigour-input"
          data-control="vigour"
          min="0"
          max="1"
          step="0.01"
          value="0.25"
        />
      </div>
      <div class="row">
        <label class="row-label" for="viscosity-input">Viscosity</label>
        <input
          type="range"
          id="viscosity-input"
          data-control="viscosity"
          min="0"
          max="1"
          step="0.01"
          value="0.06"
        />
      </div>
      <div class="row">
        <label class="row-label" for="bounce-input">Bounce</label>
        <input
          type="range"
          id="bounce-input"
          data-control="bounce"
          min="0"
          max="1"
          step="0.01"
          value="0.75"
        />
      </div>
      <div class="row">
        <label class="row-label" for="chatter-input">Chatter</label>
        <input
          type="range"
          id="chatter-input"
          data-control="chatter"
          min="0"
          max="1"
          step="0.01"
          value="0.71"
        />
      </div>
    </details>
  </div>

  <dialog id="about-dialog">
    <h2>About</h2>
    <p>
      Tap the plate to seed a cell — it sounds once, then keeps bouncing and
      keeps sounding on its own. Height is pitch; cells that collide hard
      enough breed, mixing their genomes into a child that looks and sounds
      like both parents. Colour is never stored — it is printed straight
      from the genome in three overprinted Risograph inks, so a child
      differs in ink by exactly as much as it differs in sound.
    </p>
    <p>Hold to drag a cell into place; it keeps sounding as you move it, and
      higher is higher. The home row (A S D F G H J K) plays too.</p>
    <button type="button" id="about-close">Close</button>
  </dialog>

  <script src="../scripts/main.ts"></script>
</Layout>
